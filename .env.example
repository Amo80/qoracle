SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USER_ID=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Phase 2 chamber is disabled unless explicitly set to true.
ORACLE_CHAMBER_V2_ENABLED=false
LIVING_ORACLE_V3_ENABLED=false
# Phase 4A 3D Jester requires Phase 3 and is disabled unless explicitly true.
JESTER_3D_V4A_ENABLED=false
LOVE_3D_V4B_ENABLED=false
DRAGON_3D_V4C_ENABLED=false
CHAOS_3D_V4D_ENABLED=false
ECLIPSE_3D_V4E_ENABLED=false

# Phase 6 Oracle Intelligence is inert unless the master flag, an Oracle flag,
# and a non-zero rollout percentage are all explicitly enabled.
ORACLE_INTELLIGENCE_ENABLED=false
ORACLE_INTELLIGENCE_JESTER_ENABLED=false
ORACLE_INTELLIGENCE_LOVE_ENABLED=false
ORACLE_INTELLIGENCE_DUNGEON_ENABLED=false
ORACLE_INTELLIGENCE_CHAOS_ENABLED=false
ORACLE_INTELLIGENCE_ECLIPSE_ENABLED=false
ORACLE_INTELLIGENCE_ROLLOUT_PERCENT=0
# Server-only provider configuration. Never use a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
ORACLE_INTELLIGENCE_MODEL=gpt-5.6-luna
